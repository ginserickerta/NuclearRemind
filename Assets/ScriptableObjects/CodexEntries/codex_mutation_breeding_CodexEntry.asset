  content: "\u0E01\u0E32\u0E23\u0E09\u0E32\u0E22\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E01\u0E23\u0E30\u0E15\u0E38\u0E49\u0E19\u0E43\u0E2B\u0E49\u0E40\u0E01\u0E34\u0E14\u0E01\u0E32\u0E23\u0E01\u0E25\u0E32\u0E22\u0E1E\u0E31\u0E19\u0E18\u0E38\u0E4C
