  choiceAText: "A \xB7 \u0E14\u0E36\u0E07\u0E04\u0E19\u0E08\u0E32\u0E01\u0E07\u0E32\u0E19\u0E01\u0E48\u0E2D\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E44\u0E1B\u0E1F\u0E32\u0E23\u0E4C\u0E21
