  logLinesDaily: 1
  noteTH: "\u0E1E\u0E32\u0E22\u0E38\u0E44\u0E21\u0E48\u0E40\u0E09\u0E25\u0E22 \u0E04\u0E48\u0E2D\u0E22\u0E46
