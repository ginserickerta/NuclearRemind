  record: {fileID: 0}
  infoCard: {fileID: 11400000, guid: 67de29f23afb9734dbe2d32c0975cf77, type: 2}
  crisis: {fileID: 11400000, guid: be43b5fc5cf02b040a361f8da4c312bb, type: 2}
  quiz: []
  dialoguePre:
  - speaker: 4
    textTH: "\u0E1C\u0E21\u0E17\u0E33\u0E19\u0E32\u0E21\u0E32\u0E17\u0E31\u0E49\u0E07\u0E0A\u0E35\u0E27\u0E34\u0E15
      \u0E44\u0E21\u0E48\u0E40\u0E04\u0E22\u0E40\u0E2B\u0E47\u0E19\u0E02\u0E49\u0E32\u0E27\u0E40\u0E19\u0E48\u0E32\u0E40\u0E23\u0E47\u0E27\u0E02\u0E19\u0E32\u0E14\u0E19\u0E35\u0E49
      \u2014 \u0E2A\u0E32\u0E21\u0E27\u0E31\u0E19\u0E40\u0E01\u0E25\u0E35\u0E49\u0E22\u0E07\u0E22\u0E38\u0E49\u0E07"
  - speaker: 2
    textTH: "\u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E1D\u0E35\u0E21\u0E37\u0E2D\u0E19\u0E32\u0E22\u0E2B\u0E23\u0E2D\u0E01
      Dorn \u2014 \u0E23\u0E31\u0E07\u0E2A\u0E35\u0E1E\u0E37\u0E49\u0E19\u0E2B\u0E25\u0E31\u0E07\u0E21\u0E31\u0E19\u0E2A\u0E39\u0E07\u0E1C\u0E34\u0E14\u0E1B\u0E01\u0E15\u0E34
      \u0E02\u0E2D\u0E07\u0E16\u0E36\u0E07\u0E40\u0E19\u0E48\u0E32\u0E44\u0E27\u0E02\u0E19\u0E32\u0E14\u0E19\u0E35\u0E49"
  - speaker: 4
    textTH: "\u0E41\u0E25\u0E49\u0E27\u0E19\u0E35\u0E48\u0E04\u0E38\u0E13\u0E08\u0E30\u0E43\u0E2B\u0E49\u0E1C\u0E21\u0E40\u0E2D\u0E32
      '\u0E23\u0E31\u0E07\u0E2A\u0E35' \u0E44\u0E1B\u0E22\u0E34\u0E07\u0E43\u0E2A\u0E48\u0E02\u0E49\u0E32\u0E27\u0E17\u0E35\u0E48\u0E04\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E34\u0E19\u0E07\u0E31\u0E49\u0E19\u0E40\u0E2B\u0E23\u0E2D
      \u0E1A\u0E49\u0E32\u0E44\u0E1B\u0E41\u0E25\u0E49\u0E27"
  - speaker: 3
    textTH: "\u0E09\u0E32\u0E22\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E06\u0E48\u0E32\u0E40\u0E0A\u0E37\u0E49\u0E2D
      \u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E2D\u0E32\u0E2B\u0E32\u0E23\u0E21\u0E35\u0E23\u0E31\u0E07\u0E2A\u0E35
      Dorn \u0E04\u0E19\u0E25\u0E30\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E01\u0E31\u0E19
      \u2014 \u0E21\u0E31\u0E19\u0E08\u0E30\u0E40\u0E01\u0E47\u0E1A\u0E44\u0E14\u0E49\u0E19\u0E32\u0E19\u0E02\u0E36\u0E49\u0E19
      \u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E40\u0E1B\u0E47\u0E19\u0E1E\u0E34\u0E29"
  - speaker: 4
    textTH: "...\u0E16\u0E49\u0E32\u0E21\u0E31\u0E19\u0E0A\u0E48\u0E27\u0E22\u0E43\u0E2B\u0E49\u0E04\u0E19\u0E44\u0E21\u0E48\u0E2D\u0E14\u0E15\u0E32\u0E22
      \u0E1C\u0E21\u0E01\u0E47\u0E22\u0E2D\u0E21\u0E25\u0E2D\u0E07\u0E02\u0E2D\u0E07\u0E04\u0E38\u0E13
      \u0E41\u0E15\u0E48\u0E16\u0E49\u0E32\u0E43\u0E04\u0E23\u0E1B\u0E48\u0E27\u0E22\u0E02\u0E36\u0E49\u0E19\u0E21\u0E32
      \u0E1C\u0E21\u0E40\u0E2D\u0E32\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E41\u0E19\u0E48"
  - speaker: 1
    textTH: "\u0E04\u0E19\u0E17\u0E35\u0E48\u0E01\u0E25\u0E31\u0E27\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14...
      \u0E21\u0E31\u0E01\u0E40\u0E1B\u0E47\u0E19\u0E04\u0E19\u0E17\u0E35\u0E48\u0E41\u0E1A\u0E01\u0E1B\u0E32\u0E01\u0E17\u0E49\u0E2D\u0E07\u0E04\u0E19\u0E2D\u0E37\u0E48\u0E19\u0E44\u0E27\u0E49"
  dialoguePost:
  - speaker: 4
    textTH: "\u0E22\u0E38\u0E49\u0E07\u0E02\u0E49\u0E32\u0E27\u0E44\u0E21\u0E48\u0E27\u0E48\u0E32\u0E07\u0E40\u0E1B\u0E25\u0E48\u0E32\u0E41\u0E25\u0E49\u0E27...
      \u0E40\u0E17\u0E48\u0E32\u0E19\u0E35\u0E49\u0E1C\u0E21\u0E01\u0E47\u0E2B\u0E32\u0E22\u0E43\u0E08\u0E44\u0E14\u0E49\u0E2D\u0E35\u0E01\u0E2B\u0E19\u0E48\u0E2D\u0E22"
  - speaker: 3
    textTH: "\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E22\u0E31\u0E07\u0E21\u0E35\u0E02\u0E49\u0E32\u0E27\u0E01\u0E34\u0E19
      \u0E01\u0E47\u0E22\u0E31\u0E07\u0E21\u0E35\u0E41\u0E23\u0E07\u0E2A\u0E39\u0E49\u0E15\u0E48\u0E2D
      Dorn"
  - speaker: 4
    textTH: "\u0E1C\u0E21\u0E40\u0E04\u0E22\u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E02\u0E2D\u0E07\u0E1E\u0E27\u0E01\u0E04\u0E38\u0E13\u0E21\u0E31\u0E19\u0E19\u0E48\u0E32\u0E01\u0E25\u0E31\u0E27
      \u0E41\u0E15\u0E48\u0E17\u0E35\u0E48\u0E19\u0E48\u0E32\u0E01\u0E25\u0E31\u0E27\u0E01\u0E27\u0E48\u0E32\u0E04\u0E37\u0E2D\u0E04\u0E19\u0E2D\u0E14\u0E15\u0E32\u0E22\u0E17\u0E31\u0E49\u0E07\u0E40\u0E21\u0E37\u0E2D\u0E07
      \u2014 \u0E04\u0E23\u0E32\u0E27\u0E19\u0E35\u0E49\u0E1C\u0E21\u0E40\u0E0A\u0E37\u0E48\u0E2D\u0E04\u0E38\u0E13"
  - speaker: 1
    textTH: "\u0E04\u0E27\u0E32\u0E21\u0E01\u0E25\u0E31\u0E27\u0E08\u0E32\u0E07\u0E25\u0E07\u0E44\u0E14\u0E49
      \u0E16\u0E49\u0E32\u0E04\u0E19\u0E40\u0E23\u0E32\u0E22\u0E2D\u0E21\u0E40\u0E02\u0E49\u0E32\u0E43\u0E08\u0E21\u0E31\u0E19\u0E01\u0E48\u0E2D\u0E19"
  npcLinePre: 
  innerVoiceAfter: 
  logLines: []
  logLinesDaily: 0
  noteTH: "Day 24 (\xA714) \xB7 \xA710: \"\u0E2D\u0E32\u0E2B\u0E32\u0E23>500 \u0E2B\u0E23\u0E37\u0E2D\u0E44\u0E21\u0E48\u0E21\u0E35
    Agri Dome\" \u2014 \u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E21\u0E35 Agri Dome
    \u0E27\u0E07\u0E40\u0E25\u0E47\u0E1A\u0E2B\u0E25\u0E31\u0E07\u0E08\u0E36\u0E07\u0E08\u0E23\u0E34\u0E07\u0E40\u0E2A\u0E21\u0E2D
    \u0E41\u0E25\u0E30 food_above_500 \u0E43\u0E0A\u0E49\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49
    (\u0E40\u0E1E\u0E14\u0E32\u0E19\u0E04\u0E25\u0E31\u0E07\u0E2D\u0E32\u0E2B\u0E32\u0E23
    = 500 \u2192 \u0E0A\u0E19\u0E40\u0E1E\u0E14\u0E32\u0E19 ~Day 12 \u0E27\u0E34\u0E01\u0E24\u0E15\u0E40\u0E14\u0E49\u0E07\u0E01\u0E48\u0E2D\u0E19\u0E01\u0E33\u0E2B\u0E19\u0E14
    12 \u0E27\u0E31\u0E19) \xB7 \u0E04\u0E27\u0E34\u0E0B\u0E23\u0E32\u0E22\u0E17\u0E32\u0E07\u0E40\u0E25\u0E37\u0E2D\u0E01:
    A\u2192Q6 (mutation) \xB7 B\u2192Q7 (irradiation) \xB7 C\u2192\u0E44\u0E21\u0E48\u0E21\u0E35
    \xB7 v8.5: \u0E1A\u0E17\u0E40\u0E1B\u0E34\u0E14 Dorn\u2194Kova\u2194Mira (dialoguePre)
    + \u0E1A\u0E17\u0E1B\u0E34\u0E14\u0E01\u0E25\u0E32\u0E07 Dorn\u2194Mira (dialoguePost,
    \u0E17\u0E38\u0E01 A/B/C) + Inner Voice \xD72"
