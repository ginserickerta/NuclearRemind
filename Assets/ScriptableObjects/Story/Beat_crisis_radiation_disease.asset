  crisis: {fileID: 11400000, guid: c4b833a92cec68f4689ba4ba9800f3d3, type: 2}
  quiz: []
  dialoguePre:
  - speaker: 3
    textTH: "\u0E2B\u0E22\u0E38\u0E14\u0E2A\u0E48\u0E07\u0E04\u0E19\u0E25\u0E07\u0E40\u0E2B\u0E21\u0E37\u0E2D\u0E07\u0E01\u0E48\u0E2D\u0E19
      \u2014 \u0E17\u0E35\u0E48\u0E25\u0E49\u0E21\u0E44\u0E1B\u0E2A\u0E34\u0E1A\u0E2B\u0E49\u0E32\u0E04\u0E19\u0E19\u0E48\u0E30
      \u0E44\u0E21\u0E48\u0E43\u0E0A\u0E48\u0E2B\u0E21\u0E14\u0E41\u0E23\u0E07 \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E21\u0E31\u0E19\u0E40\u0E23\u0E34\u0E48\u0E21\u0E42\u0E15\u0E1C\u0E34\u0E14\u0E17\u0E35\u0E48\u0E41\u0E25\u0E49\u0E27"
  - speaker: 2
    textTH: "\u0E42\u0E15\u0E1C\u0E34\u0E14\u0E17\u0E35\u0E48... \u0E2B\u0E21\u0E32\u0E22\u0E04\u0E27\u0E32\u0E21\u0E27\u0E48\u0E32\u0E22\u0E31\u0E07\u0E44\u0E07"
  - speaker: 3
    textTH: "\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E2A\u0E30\u0E2A\u0E21 Kova \u0E09\u0E31\u0E19\u0E40\u0E04\u0E22\u0E40\u0E2B\u0E47\u0E19\u0E21\u0E32\u0E01\u0E48\u0E2D\u0E19
      \u0E1B\u0E25\u0E48\u0E2D\u0E22\u0E44\u0E27\u0E49\u0E2D\u0E35\u0E01\u0E2A\u0E32\u0E21\u0E27\u0E31\u0E19\u0E21\u0E35\u0E04\u0E19\u0E15\u0E32\u0E22\u0E41\u0E19\u0E48"
  - speaker: 2
    textTH: "\u0E41\u0E25\u0E49\u0E27\u0E41\u0E01\u0E49\u0E22\u0E31\u0E07\u0E44\u0E07"
  - speaker: 3
    textTH: "\u0E21\u0E35\u0E17\u0E32\u0E07\u0E2D\u0E22\u0E39\u0E48 \u2014 \u0E41\u0E15\u0E48\u0E44\u0E21\u0E48\u0E21\u0E35\u0E17\u0E32\u0E07\u0E44\u0E2B\u0E19\u0E1F\u0E23\u0E35
      \u0E40\u0E2D\u0E32\u0E04\u0E19 \u0E40\u0E2D\u0E32\u0E1E\u0E25\u0E31\u0E07\u0E07\u0E32\u0E19
      \u0E2B\u0E23\u0E37\u0E2D\u0E40\u0E2D\u0E32\u0E40\u0E27\u0E25\u0E32\u0E44\u0E1B\u0E40\u0E2A\u0E35\u0E48\u0E22\u0E07
      \u0E40\u0E25\u0E37\u0E2D\u0E01\u0E40\u0E2D\u0E32"
  - speaker: 1
    textTH: "\u0E04\u0E19\u0E1E\u0E27\u0E01\u0E19\u0E31\u0E49\u0E19\u0E02\u0E38\u0E14\u0E41\u0E23\u0E48\u0E43\u0E2B\u0E49\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E21\u0E32\u0E15\u0E25\u0E2D\u0E14...
      \u0E1C\u0E21\u0E08\u0E30\u0E2B\u0E31\u0E19\u0E2B\u0E25\u0E31\u0E07\u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49"
  dialoguePost: []
  npcLinePre: 
  innerVoiceAfter: 
  logLines: []
  logLinesDaily: 0
  noteTH: "Day 20 (\xA714) \xB7 \xA710: \u0E2A\u0E48\u0E07\u0E04\u0E19\u0E02\u0E38\u0E14\u0E42\u0E0B\u0E19\u0E40\u0E2A\u0E35\u0E48\u0E22\u0E07\u0E21\u0E32\u0E01\u0E40\u0E01\u0E34\u0E19\u0E44\u0E1B
    \u2014 \u0E08\u0E33\u0E25\u0E2D\u0E07\u0E14\u0E49\u0E27\u0E22 RadiationManager
    exposure \u0E2A\u0E30\u0E2A\u0E21 (\u0E25\u0E14\u0E14\u0E49\u0E27\u0E22 Shelter/Medic
    \u0E15\u0E32\u0E21 ALARA) \xB7 \u0E40\u0E1E\u0E14\u0E32\u0E19\u0E27\u0E31\u0E19
