  dialoguePre:
  - speaker: 2
    textTH: "\u0E40\u0E2B\u0E47\u0E19\u0E2B\u0E2D\u0E2A\u0E39\u0E07\u0E01\u0E25\u0E32\u0E07\u0E40\u0E21\u0E37\u0E2D\u0E07\u0E44\u0E2B\u0E21
