    emotion: 0
  - speaker: 1
    textTH: "\u0E2B\u0E2D\u0E19\u0E31\u0E48\u0E19 \u0E17\u0E35\u0E21\u0E40\u0E01\u0E48\u0E32\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E04\u0E49\u0E32\u0E07\u0E44\u0E27\u0E49\u0E04\u0E23\u0E36\u0E48\u0E07\u0E17\u0E32\u0E07...
