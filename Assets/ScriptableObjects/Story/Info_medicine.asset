  m_Script: {fileID: 11500000, guid: e129e0a1c799b2f419209d1c8c4cce81, type: 3}
  m_Name: Info_medicine
  m_EditorClassIdentifier: NuclearReMind::NuclearReMind.InfoCardSO
  title: "\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E01\u0E31\u0E1A\u0E23\u0E48\u0E32\u0E07\u0E01\u0E32\u0E22\u0E04\u0E19"
  category: 2
  bodyTH: "\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E1B\u0E23\u0E34\u0E21\u0E32\u0E13\u0E2A\u0E39\u0E07\u0E17\u0E33\u0E25\u0E32\u0E22\u0E40\u0E0B\u0E25\u0E25\u0E4C\u0E43\u0E19\u0E23\u0E48\u0E32\u0E07\u0E01\u0E32\u0E22
    \u0E17\u0E33\u0E43\u0E2B\u0E49\u0E40\u0E01\u0E34\u0E14\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E23\u0E49\u0E32\u0E22\u0E44\u0E14\u0E49\r\n\u0E01\u0E32\u0E23\u0E23\u0E31\u0E01\u0E29\u0E32\u0E2A\u0E21\u0E31\u0E22\u0E43\u0E2B\u0E21\u0E48\u0E43\u0E0A\u0E49\u0E40\u0E27\u0E0A\u0E28\u0E32\u0E2A\u0E15\u0E23\u0E4C\u0E19\u0E34\u0E27\u0E40\u0E04\u0E25\u0E35\u0E22\u0E23\u0E4C
    \u2014 \u0E09\u0E35\u0E14\u0E2A\u0E32\u0E23\u0E40\u0E20\u0E2A\u0E31\u0E0A\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E40\u0E02\u0E49\u0E32\u0E44\u0E1B
    \"\u0E16\u0E48\u0E32\u0E22\u0E20\u0E32\u0E1E\" \u0E2B\u0E32\u0E15\u0E33\u0E41\u0E2B\u0E19\u0E48\u0E07\u0E01\u0E48\u0E2D\u0E19\r\n\u0E41\u0E25\u0E49\u0E27\u0E04\u0E48\u0E2D\u0E22\u0E2A\u0E48\u0E07\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E44\u0E1B
    \"\u0E17\u0E33\u0E25\u0E32\u0E22\" \u0E40\u0E09\u0E1E\u0E32\u0E30\u0E08\u0E38\u0E14
    \u0E41\u0E21\u0E48\u0E19\u0E22\u0E33 \u0E44\u0E21\u0E48\u0E01\u0E23\u0E30\u0E17\u0E1A\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E14\u0E35\r\n\u0E2B\u0E25\u0E31\u0E01\u0E2A\u0E33\u0E04\u0E31\u0E0D:
    ALARA \u2014 \u0E43\u0E2B\u0E49\u0E04\u0E19\u0E23\u0E31\u0E1A\u0E23\u0E31\u0E07\u0E2A\u0E35\u0E19\u0E49\u0E2D\u0E22\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14\u0E40\u0E17\u0E48\u0E32\u0E17\u0E35\u0E48\u0E17\u0E33\u0E44\u0E14\u0E49
    \u0E41\u0E25\u0E30\u0E1B\u0E01\u0E1B\u0E49\u0E2D\u0E07\u0E01\u0E25\u0E38\u0E48\u0E21\u0E40\u0E1B\u0E23\u0E32\u0E30\u0E1A\u0E32\u0E07
    (\u0E1C\u0E39\u0E49\u0E1B\u0E48\u0E27\u0E22/\u0E40\u0E14\u0E47\u0E01) \u0E01\u0E48\u0E2D\u0E19"
  buttonLabel: "\u0E23\u0E31\u0E1A\u0E17\u0E23\u0E32\u0E1A"
