  m_EditorClassIdentifier: NuclearReMind::NuclearReMind.InfoCardSO
  title: "\u0E2B\u0E25\u0E48\u0E2D\u0E40\u0E22\u0E47\u0E19\u0E40\u0E15\u0E32\u0E14\u0E49\u0E27\u0E22\u0E02\u0E14\u0E25\u0E27\u0E14\u0E04\u0E39\u0E48"
  category: 1
  bodyTH: "\u0E2A\u0E19\u0E32\u0E21\u0E41\u0E21\u0E48\u0E40\u0E2B\u0E25\u0E47\u0E01\u0E17\u0E35\u0E48\u0E02\u0E31\u0E07\u0E1E\u0E25\u0E32\u0E2A\u0E21\u0E32\u0E44\u0E27\u0E49
    \u0E01\u0E47\u0E04\u0E37\u0E2D \"\u0E23\u0E30\u0E1A\u0E1A\u0E2B\u0E25\u0E48\u0E2D\u0E40\u0E22\u0E47\u0E19\"
    \u0E02\u0E2D\u0E07\u0E40\u0E15\u0E32\u0E19\u0E35\u0E49 \u0E22\u0E34\u0E48\u0E07\u0E2A\u0E19\u0E32\u0E21\u0E41\u0E23\u0E07
    \u0E22\u0E34\u0E48\u0E07\u0E01\u0E31\u0E19\u0E04\u0E27\u0E32\u0E21\u0E23\u0E49\u0E2D\u0E19
    (HEAT) \u0E44\u0E21\u0E48\u0E43\u0E2B\u0E49\u0E17\u0E30\u0E25\u0E38\u0E1C\u0E19\u0E31\u0E07\u0E44\u0E14\u0E49\u0E21\u0E32\u0E01\r\n\u0E40\u0E23\u0E32\u0E40\u0E1E\u0E34\u0E48\u0E21\u0E01\u0E33\u0E25\u0E31\u0E07\u0E2B\u0E25\u0E48\u0E2D\u0E40\u0E22\u0E47\u0E19\u0E44\u0E14\u0E49\u0E14\u0E49\u0E27\u0E22\u0E01\u0E32\u0E23
    \u0E15\u0E34\u0E14\u0E15\u0E31\u0E49\u0E07/\u0E2D\u0E31\u0E1B\u0E40\u0E01\u0E23\u0E14\u0E02\u0E14\u0E25\u0E27\u0E14
    2 \u0E0A\u0E19\u0E34\u0E14 \u0E17\u0E35\u0E48\u0E2B\u0E2D\u0E04\u0E27\u0E1A\u0E04\u0E38\u0E21\u0E40\u0E15\u0E32:\r\n\u2022
    Toroidal Coils \u2014 \u0E02\u0E14\u0E25\u0E27\u0E14\u0E27\u0E07\u0E23\u0E2D\u0E1A
    \u0E1A\u0E35\u0E1A\u0E1E\u0E25\u0E32\u0E2A\u0E21\u0E32\u0E43\u0E2B\u0E49\u0E27\u0E34\u0E48\u0E07\u0E40\u0E1B\u0E47\u0E19\u0E27\u0E07
    \u2192 \u0E22\u0E01\u0E40\u0E1E\u0E14\u0E32\u0E19\u0E01\u0E33\u0E25\u0E31\u0E07\u0E2B\u0E25\u0E48\u0E2D\u0E40\u0E22\u0E47\u0E19
    (\u0E23\u0E31\u0E1A Boost \u0E44\u0E14\u0E49\u0E41\u0E23\u0E07\u0E02\u0E36\u0E49\u0E19)\r\n\u2022
    Poloidal Coils \u2014 \u0E02\u0E14\u0E25\u0E27\u0E14\u0E23\u0E31\u0E14\u0E41\u0E19\u0E27\u0E15\u0E31\u0E49\u0E07
    \u0E01\u0E31\u0E19\u0E1E\u0E25\u0E32\u0E2A\u0E21\u0E32\u0E0A\u0E19\u0E1C\u0E19\u0E31\u0E07
    \u2192 \u0E25\u0E14 HEAT \u0E15\u0E48\u0E2D\u0E40\u0E17\u0E34\u0E23\u0E4C\u0E19
    \u0E41\u0E25\u0E30\u0E01\u0E31\u0E19\u0E40\u0E15\u0E32\u0E2A\u0E36\u0E01\u0E17\u0E35\u0E25\u0E30\u0E19\u0E34\u0E14\r\n\u2192
    \u0E16\u0E49\u0E32 HEAT \u0E44\u0E15\u0E48\u0E43\u0E01\u0E25\u0E49 100 (Meltdown)
    \u0E43\u0E2B\u0E49\u0E40\u0E2A\u0E23\u0E34\u0E21\u0E02\u0E14\u0E25\u0E27\u0E14\u0E01\u0E48\u0E2D\u0E19\u0E40\u0E2A\u0E21\u0E2D
    \u0E2D\u0E22\u0E48\u0E32\u0E40\u0E1E\u0E34\u0E48\u0E07\u0E40\u0E23\u0E48\u0E07\u0E40\u0E15\u0E32"
  buttonLabel: "\u0E23\u0E31\u0E1A\u0E17\u0E23\u0E32\u0E1A"
