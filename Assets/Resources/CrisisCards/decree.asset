  - label: "\u0E40\u0E01\u0E13\u0E11\u0E4C\u0E1C\u0E39\u0E49\u0E1B\u0E48\u0E27\u0E22\u0E23\u0E48\u0E27\u0E21\u0E07\u0E32\u0E19"
    effectSummary: "+\u0E41\u0E23\u0E07\u0E07\u0E32\u0E19\u0E2B\u0E25\u0E48\u0E2D\u0E40\u0E22\u0E47\u0E19
